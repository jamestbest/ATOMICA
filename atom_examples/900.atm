ExitCodes :: data {
    pos: Position

    EXIT_SUCCESS= 0
    EXIT_FAILURE= 1
}

#insert ${ #insert ${ x: i4 } = 0 }
// #insert ${ x: i4 = 0 }

a: i4?= 12
y :: 18
test :: 1 + -2 + a++ - -(--a) + a?y + a?

x :: import "901_fib.atm"

entry main :: (argc: i4, argv: []string): i4 {
    if (argc != 3) {
        print_usage();
        ret EXIT_FAILURE
    }

    a : code? : ${x: i4= 0+12}
//    b :: $""

//    #insert a
    b :: a! |:err| {print("failed"); ret err}

    c: id: $a

    filename: string= argv[1]
    output_folder:= argv[2]

    file := open(filename)!
    defer close(file')

    // files is marked, [..]'string
    files := get_files_in_folder(output_folder)
    defer free(files')
    for (f: files) {
        print("Folder contains: %", f)
    }

    ret EXIT_SUCCESS
}

print_usage :: (): void {
    print("./out <filename> <output_folder>\n")
}

open :: (filename: string): !>'File {
    if (1) ret! NOT_FOUND(filename)

    if (0) ret! PERMISSION_DENIED

    ret file_out'
}

close :: (file: >'File): void {
    unmark file'
}

get_files_in_folder :: (folder: string): [..]'string {
    out: [..]'string= []

    ret out'
}
